<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewGuideColorDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_swatch_circle" />

        <TextView
            android:id="@+id/tvGuideColorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Brown" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGuideDigit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="1" />

    <TextView
        android:id="@+id/tvGuideMultiplier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="×10 Ω" />

    <TextView
        android:id="@+id/tvGuideTolerance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="±1%" />

    <TextView
        android:id="@+id/tvGuideTcr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="100" />
</LinearLayout>
